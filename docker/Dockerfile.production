FROM node:22-alpine AS build

WORKDIR /app

ARG VITE_BOTSYNC_API_URL
ARG VITE_BOTSYNC_PORTAL_URL

ENV VITE_BOTSYNC_API_URL=$VITE_BOTSYNC_API_URL
ENV VITE_BOTSYNC_PORTAL_URL=$VITE_BOTSYNC_PORTAL_URL

COPY package.json package-lock.json ./
RUN npm install --global npm@11.6.2 && npm ci

COPY . .
RUN npm run build

FROM node:22-alpine AS runtime

WORKDIR /app
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3005

COPY --from=build /app/.output ./.output

EXPOSE 3005

CMD ["node", ".output/server/index.mjs"]
